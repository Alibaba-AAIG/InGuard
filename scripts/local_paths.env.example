# InGuard local-path configuration (template).
#
# Copy this file to scripts/local_paths.env and fill in the real data
# paths. The copy is GITIGNORED — real paths never enter the repository.
#
# Load order used by scripts/smoke_test.py:
#   1. values already present in the environment win (they are not overridden)
#   2. everything below is exported into os.environ
#   3. values may reference earlier lines via ${VAR}
#
# Tip: keep INGUARD_DATA_ROOT / INGUARD_OUTPUT_ROOT / INGUARD_MODELS_ROOT on a
# LOCAL disk (e.g. ~/inguard_data_links). They receive symlinks created by the
# smoke test, and symlink creation on network/OSS mounts can be unreliable.

# ------------------------------------------------------------------
# Standard InGuard environment variables (see README "Configuration")
# ------------------------------------------------------------------
# INGUARD_MODELS_ROOT must contain the five T2I model dirs under the names
# used by MODEL_REGISTRY (Z-Image-Turbo, Qwen-Image-2512, ...). If the server
# keeps them elsewhere / under other names, point this at a local dir and let
# `--stage link` create the symlinks (see SERVER_* below).
INGUARD_MODELS_ROOT=/path/to/models          # five T2I model weight dirs
INGUARD_CKPT_ROOT=/path/to/checkpoints       # training checkpoint root

# Where the smoke test builds the RevGen layout (symlinks). Local disk!
INGUARD_DATA_ROOT=~/inguard_data_links/data
INGUARD_OUTPUT_ROOT=~/inguard_data_links/revgen

INGUARD_DEVICE=cuda:0

# ------------------------------------------------------------------
# Original locations of the data (only used by
# `smoke_test.py --stage link` to create the symlinks above)
# ------------------------------------------------------------------
# The four RevGen CSVs at their original locations (any original names are fine;
# they are linked to the standard RevGen/ names).
SERVER_CSV_TRAINSET=/path/to/trainset.csv
SERVER_CSV_TESTSET=/path/to/testset.csv
SERVER_CSV_TRAIN_LABELED=/path/to/trainset_labeled.csv
SERVER_CSV_TEST_LABELED=/path/to/testset_labeled.csv

# Root of the generated benchmark data. Expected layout:
#   {SERVER_GEN_ROOT}/{model}/{split}set[vX-Y-]seed42-{res}-{steps}steps/
# (the version infix is optional — the newest matching directory is linked)
SERVER_GEN_ROOT=/path/to/results/Native_Guardrail_Dataset

# T2I model sources. The code expects {INGUARD_MODELS_ROOT}/<standard name>
# (Z-Image-Turbo, Qwen-Image-2512, HunyuanImage-2.1-Diffusers,
# FLUX.2-klein-base-9B, InternVL-U). If a model lives elsewhere on this
# machine, set its per-model variable to the FULL path and `--stage link`
# creates the symlink (unset ones are simply skipped):
SERVER_MODEL_Z_IMAGE=/path/to/Z-Image-Turbo
SERVER_MODEL_QWEN=/path/to/Qwen-Image-2512
SERVER_MODEL_HUNYUAN=/path/to/HunyuanImage-2.1-Diffusers
SERVER_MODEL_FLUX=/path/to/FLUX.2-klein-base-9B
SERVER_MODEL_INTERNVLU=/path/to/InternVL-U

# Optional torch hub cache (linked to $INGUARD_MODELS_ROOT/hub so ImageNet
# pretrain weights are not re-downloaded):
SERVER_TORCH_HUB=/path/to/torch/hub

# Optional InternVL-U pipeline code dir (the repo ships its own port under
# sage/backends/internvlu — set this only if you want the external one):
SERVER_INTERNVLU_CODE=/path/to/InternVL-U-main

# OpenImages v7 root (Phase-A pretraining only). Expected layout:
#   {SERVER_OPENIMAGES_ROOT}/train/{latents,images,labels}
SERVER_OPENIMAGES_ROOT=/path/to/open-images-v7
